@page "/mainmenu"

@inject NavigationManager Navigation



<PageTitle>Main Menu</PageTitle>

<div class="d-flex flex-column justify-content-center align-items-center container vh-100">
    <div class="row justify-content-center">
        <div class="col text-center">
            <button class="btn menu-btn" @onclick="NavigateToTeamMenu">
                Start Game
            </button>
        </div>
    </div>
    <div class="row justify-content-center">
        <div class="col text-center">
            <button class="btn menu-btn" @onclick="NavigateToSettings">
                Setting
            </button>
        </div>
    </div>
    <div class="row justify-content-center">
        <div class="col text-center">
            <button class="btn menu-btn" @onclick="NavigateToExit">
                Exit
            </button>
        </div>
    </div>
</div>

@code {

    private void NavigateToTeamMenu()
    {
        Navigation.NavigateTo(Constants.TeamMenuUrl);
    }

    private void NavigateToSettings()
    {
        Navigation.NavigateTo(Constants.SettingsUrl);
    }

    private void NavigateToExit()
    {
        // Gracefully shutdown the app. 
    }

}
