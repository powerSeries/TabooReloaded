@page "/"
@using TabooReloaded.Shared.Services
@inject IFormFactor FormFactor
@inject IDatabaseService DatabaseService
<PageTitle>Home</PageTitle>

@if (isLoading)
{
    <div class="container vh-100 d-flex flex-column justify-content-center">
        <div class="row">
            <div class="col text-center fade-in">
                <h1>Taboo Reloaded 2</h1>
            </div>

        </div>
        <div class="row mt-3">
            <div class="col text-center fade-in">
                <h2>Electric Boogaloo </h2>
            </div>
        </div>
    </div>
}
else
{
    <MainMenu />
}

@code {
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var connected = await DatabaseService.ConnectAsync();
        if (connected)
        {
            var word = await DatabaseService.GetTabooWordAsync();
            await Task.Delay(Constants.LOADING_TIME);
            isLoading = false;
        }
    }

    private string factor => FormFactor.GetFormFactor();
    private string platform => FormFactor.GetPlatform();
}
